<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" default-locale="fr-FR" demote-non-dropping-particle="never" page-range-format="expanded">
  <info>
    <title>Facultés Loyola Paris 2026-2027</title>
    <title-short>FLP 2026-2027</title-short>
    <id>http://www.zotero.org/styles/facultes-loyola-paris-2026-2027</id>
    <link href="http://www.zotero.org/styles/facultes-loyola-paris-2026-2027" rel="self"/>
    <link href="https://www.facultes-loyola.fr/" rel="documentation"/>
    <author>
      <name>Facultés Loyola Paris</name>
    </author>
    <category citation-format="note"/>
    <category field="humanities"/>
    <category field="philosophy"/>
    <category field="theology"/>
    <summary>Style de notes et bibliographie conforme au Vade-mecum de présentation des travaux écrits des Facultés Loyola Paris (version finale du 1er octobre 2026 ; règles bibliographiques identiques à celles du 24 septembre 2026). Philosophie et théologie. Inversion note/bibliographie, noms en petites capitales, ville d'édition obligatoire, cadratin pour auteur répété, titre court pour les citations ultérieures, Ibid. conservé, Id. et art. cit. proscrits. Espaces insécables U+00A0 (celles de Word) à l'intérieur des guillemets et devant le point-virgule, comme dans la locale française de Zotero. Prise en charge des livres, contributions, articles (imprimés, en ligne, DOI), pages Internet, thèses, podcasts, vidéos et films, tomes, éditions successives et dates d'édition originale (champs « Date originale », « Éditeur original », « Lieu original » de Zotero 10, ou champ Extra pour les versions antérieures). Vérifié avec citeproc-js 1.4.61 et la locale fr-FR livrés avec Zotero 10.0.4. Versions : l’identifiant et le titre portent l’année universitaire du Vade-mecum (2026-2027) et ne changent qu’avec une nouvelle édition de celui-ci ; les corrections sans changement de règle gardent le même identifiant et ne modifient que la date de mise à jour et la liste ci-dessous. Révision 2 (4 novembre 2026) : espaces insécables U+00A0 à l’intérieur des guillemets et devant le point-virgule. Révision 1 (12 octobre 2026) : mention « (dir.) » quand les directeurs tiennent lieu d’auteurs. Version initiale (24 septembre 2026).</summary>
    <updated>2026-11-04T12:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License.</rights>
  </info>

  <!-- ========== TERMES FRANÇAIS PROPRES AU VADE-MECUM ========== -->
  <locale xml:lang="fr">
    <terms>
      <term name="in">dans</term>
      <term name="editor" form="short">dir.</term>
      <term name="editor" form="verb-short">dir.</term>
      <term name="translator" form="short">trad.</term>
      <term name="translator" form="verb-short">trad.</term>
      <term name="ibid">Ibid.</term>
      <term name="and">et</term>
      <term name="et-al">et alii</term>
      <term name="accessed">consulté le</term>
      <term name="edition" form="short">éd.</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>p.</multiple>
      </term>
      <term name="volume" form="short">t.</term>
    </terms>
  </locale>

  <!-- ========== MACROS : NOMS ========== -->

  <!-- Auteur, forme note : Prénom NOM (nom en petites capitales). Sans auteur, les directeurs sont cités suivis de « (dir.) ».
       Pour un film, le metteur en scène (rôle « director ») ; pour un podcast, le diffuseur (rôle « podcaster », CSL « host »). -->
  <macro name="author-note">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <et-al term="et-al" font-style="italic"/>
      <substitute>
        <names variable="director"/>
        <names variable="host"/>
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix="&#x20;(" suffix=")"/>
        </names>
        <names variable="translator"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Auteur, forme note abrégée : P. NOM -->
  <macro name="author-note-short">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=".&#xA0;">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <et-al term="et-al" font-style="italic"/>
      <substitute>
        <names variable="director"/>
        <names variable="host"/>
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=".&#xA0;">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix="&#x20;(" suffix=")"/>
        </names>
        <text macro="title-short"/>
      </substitute>
    </names>
  </macro>

  <!-- Auteur, forme bibliographie : NOM Prénom (séparés par une espace insécable, sans virgule) -->
  <macro name="author-bib">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="all" sort-separator="&#xA0;">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <et-al term="et-al" font-style="italic"/>
      <substitute>
        <names variable="director"/>
        <names variable="host"/>
        <names variable="editor">
          <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" name-as-sort-order="all" sort-separator="&#xA0;">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <et-al term="et-al" font-style="italic"/>
          <label form="short" prefix="&#x20;(" suffix=")"/>
        </names>
        <names variable="translator"/>
        <text macro="title"/>
      </substitute>
    </names>
  </macro>

  <!-- Clé de tri : nom de famille en casse normale -->
  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" "/>
      <substitute>
        <names variable="director"/>
        <names variable="host"/>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <!-- ========== MACROS : TITRES ========== -->

  <!-- Titre : italique (ouvrages, thèses, films) ; guillemets « » (articles, contributions, épisodes de podcast) ;
       sans marque (pages Internet). -->
  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary post-weblog broadcast" match="any">
        <text variable="title" prefix="&#xAB;&#xA0;" suffix="&#xA0;&#xBB;"/>
      </if>
      <else-if type="webpage" match="any">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Titre court (citation ultérieure) ; Zotero reprend le titre complet si le champ « Titre abrégé » est vide -->
  <macro name="title-short">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter paper-conference entry-encyclopedia entry-dictionary post-weblog broadcast" match="any">
        <text variable="title" form="short" prefix="&#xAB;&#xA0;" suffix="&#xA0;&#xBB;"/>
      </if>
      <else-if type="webpage" match="any">
        <text variable="title" form="short"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- Date de l'édition originale entre parenthèses après le titre : Critique de la raison pure (1781).
       Saisie dans Zotero 10, champ « Date originale » (ou, avant Zotero 10, champ Extra : « original-date: 1781 »).
       Non affichée lorsque l'on signale des éditions successives (voir macro « publication »). -->
  <macro name="original-date">
    <choose>
      <if variable="original-publisher"/>
      <else-if variable="original-date">
        <date variable="original-date" prefix=" (" suffix=")">
          <date-part name="year"/>
        </date>
      </else-if>
    </choose>
  </macro>

  <!-- Titre suivi, le cas échéant, de la date d'édition originale -->
  <macro name="title-full">
    <group>
      <text macro="title"/>
      <text macro="original-date"/>
    </group>
  </macro>

  <!-- Nature du document : type de thèse (champ « Type » de Zotero) ; [Podcast] ; [Film] ou [Vidéo]
       (pour une vidéo, saisir « Vidéo » dans le champ « Genre » de Zotero) -->
  <macro name="genre">
    <choose>
      <if type="thesis">
        <text variable="genre"/>
      </if>
      <else-if type="broadcast">
        <text value="[Podcast]"/>
      </else-if>
      <else-if type="motion_picture">
        <choose>
          <if variable="genre">
            <text variable="genre" prefix="[" suffix="]"/>
          </if>
          <else>
            <text value="[Film]"/>
          </else>
        </choose>
      </else-if>
    </choose>
  </macro>

  <!-- ========== MACROS : CONTENANT ========== -->

  <!-- Numéro de fascicule : nº (o en exposant) + espace insécable + numéro -->
  <macro name="issue">
    <group>
      <text value="n"/>
      <text value="o" vertical-align="sup"/>
      <text variable="issue" prefix="&#xA0;"/>
    </group>
  </macro>

  <!-- Numéro d'épisode (podcast) : nº (o en exposant) + espace insécable + numéro -->
  <macro name="number">
    <group>
      <text value="n"/>
      <text value="o" vertical-align="sup"/>
      <text variable="number" prefix="&#xA0;"/>
    </group>
  </macro>

  <!-- « dans » + responsables (dir.) + titre de l'hôte (contributions) ; revue (articles) ; série (podcasts) -->
  <macro name="container">
    <choose>
      <if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=", ">
          <group>
            <text term="in" suffix="&#x20;"/>
            <names variable="editor" delimiter=", ">
              <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never">
                <name-part name="family" font-variant="small-caps"/>
              </name>
              <label form="short" prefix="&#x20;(" suffix=")"/>
            </names>
          </group>
          <text variable="container-title" font-style="italic"/>
        </group>
      </if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <group delimiter="&#xA0;">
            <text value="vol."/>
            <text variable="volume"/>
          </group>
          <text macro="issue"/>
        </group>
      </else-if>
      <else-if type="broadcast">
        <group delimiter=", ">
          <choose>
            <if variable="container-title">
              <group>
                <text term="in" suffix="&#x20;"/>
                <text variable="container-title" font-style="italic"/>
              </group>
            </if>
            <else-if variable="collection-title">
              <group>
                <text term="in" suffix="&#x20;"/>
                <text variable="collection-title" font-style="italic"/>
              </group>
            </else-if>
          </choose>
          <text macro="number"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- Tome (livres) : t. + numéro tel que saisi (chiffres romains pour les œuvres complètes : t. XIV) -->
  <macro name="volume">
    <choose>
      <if type="book">
        <group delimiter="&#xA0;">
          <text term="volume" form="short"/>
          <text variable="volume"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Traducteur : trad. P. Nom (nom en minuscules, prénom abrégé) -->
  <macro name="translator">
    <names variable="translator">
      <label form="short" suffix="&#x20;"/>
      <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=".&#xA0;"/>
    </names>
  </macro>

  <!-- Mention d'édition : 2e éd. (le suffixe ordinal « e », « re », « er » est fourni par la locale fr-FR de Zotero,
       qui le compose en exposant depuis sa mise à jour du 18 octobre 2025, livrée avec Zotero 10) -->
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter="&#xA0;">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <!-- ========== MACROS : PUBLICATION ========== -->

  <!-- Ville d'édition (obligatoire) + éditeur ; établissement de soutenance seul pour les thèses -->
  <macro name="publisher">
    <choose>
      <if type="thesis">
        <text variable="publisher"/>
      </if>
      <else>
        <group delimiter=", ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- Collection : « collection » numéro -->
  <macro name="collection">
    <choose>
      <if type="broadcast"/>
      <else>
        <group delimiter="&#xA0;">
          <text variable="collection-title" prefix="&#xAB;&#xA0;" suffix="&#xA0;&#xBB;"/>
          <text variable="collection-number"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- Année -->
  <macro name="issued">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any"/>
      <else>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </else>
    </choose>
  </macro>

  <!-- Ville, éditeur, collection, année.
       Éditions successives (Zotero 10 : champs « Lieu original », « Éditeur original », « Date originale » ; avant Zotero 10, champ Extra) :
       Paris, Centurion, ¹1981 ; Paris, Bayard, 2019.
       Films et vidéos : année de sortie, puis société de production. -->
  <macro name="publication">
    <choose>
      <if variable="original-publisher">
        <group delimiter="&#xA0;; ">
          <group delimiter=", ">
            <text variable="original-publisher-place"/>
            <text variable="original-publisher"/>
            <group>
              <text value="1" vertical-align="sup"/>
              <date variable="original-date">
                <date-part name="year"/>
              </date>
            </group>
          </group>
          <group delimiter=", ">
            <text macro="publisher"/>
            <text macro="collection"/>
            <text macro="issued"/>
          </group>
        </group>
      </if>
      <else-if type="motion_picture">
        <group delimiter=", ">
          <text macro="issued"/>
          <text macro="publisher"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="collection"/>
          <text macro="issued"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ========== MACROS : PAGES ET ACCÈS ========== -->

  <!-- Pagination de la citation (note) : p. XX -->
  <macro name="locator">
    <group delimiter="&#xA0;">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>

  <!-- Pagination de l'extrait (bibliographie : contribution, article) : p. XX-XX -->
  <macro name="pages">
    <choose>
      <if type="chapter paper-conference article-journal article-magazine article-newspaper entry-encyclopedia entry-dictionary" match="any">
        <group delimiter="&#xA0;">
          <text term="page" form="short"/>
          <text variable="page"/>
        </group>
      </if>
    </choose>
  </macro>

  <!-- Accès en ligne : URL (à saisir sans le préfixe https://) + consulté le jj mois aaaa.
       Réservé aux pages Internet, billets, articles de revue en ligne, thèses en ligne, podcasts, vidéos.
       Omis lorsqu'un DOI existe (le DOI remplace l'URL et la date de consultation). -->
  <macro name="access">
    <choose>
      <if variable="DOI"/>
      <else-if type="webpage post-weblog article-journal article-magazine article-newspaper thesis broadcast motion_picture" match="any">
        <group delimiter=", ">
          <text variable="URL"/>
          <group delimiter="&#x20;">
            <text term="accessed"/>
            <date variable="accessed">
              <date-part name="day" suffix="&#x20;"/>
              <date-part name="month" suffix="&#x20;"/>
              <date-part name="year"/>
            </date>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>

  <!-- Identifiant pérenne : . DOI : 10.xxxx (après la pagination, précédé d'un point) -->
  <macro name="doi">
    <text variable="DOI" prefix=". DOI&#xA0;: "/>
  </macro>

  <!-- ========== CITATION (NOTE DE BAS DE PAGE) ========== -->
  <citation et-al-min="4" et-al-use-first="3" disambiguate-add-givenname="false" disambiguate-add-names="false">
    <layout prefix="" suffix="." delimiter="&#xA0;; ">
      <choose>
        <!-- Référence immédiatement précédente, avec page -->
        <if position="ibid-with-locator">
          <group delimiter=", ">
            <text term="ibid" font-style="italic"/>
            <text macro="locator"/>
          </group>
        </if>
        <!-- Référence immédiatement précédente, même page -->
        <else-if position="ibid">
          <text term="ibid" font-style="italic"/>
        </else-if>
        <!-- Occurrence ultérieure : forme abrégée -->
        <else-if position="subsequent">
          <group delimiter=", ">
            <text macro="author-note-short"/>
            <text macro="title-short"/>
            <text macro="locator"/>
          </group>
        </else-if>
        <!-- Première occurrence : forme complète -->
        <else>
          <group>
            <group delimiter=", ">
              <text macro="author-note"/>
              <text macro="title-full"/>
              <text macro="genre"/>
              <text macro="container"/>
              <text macro="volume"/>
              <text macro="edition"/>
              <text macro="translator"/>
              <text macro="publication"/>
              <text macro="locator"/>
              <text macro="access"/>
            </group>
            <text macro="doi"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <!-- ========== BIBLIOGRAPHIE ========== -->
  <bibliography subsequent-author-substitute="&#x2014;" subsequent-author-substitute-rule="complete-all" et-al-min="4" et-al-use-first="3">
    <sort>
      <key macro="author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group>
        <group delimiter=", ">
          <text macro="author-bib"/>
          <text macro="title-full"/>
          <text macro="genre"/>
          <text macro="container"/>
          <text macro="volume"/>
          <text macro="edition"/>
          <text macro="translator"/>
          <text macro="publication"/>
          <text macro="pages"/>
          <text macro="access"/>
        </group>
        <text macro="doi"/>
      </group>
    </layout>
  </bibliography>
</style>
